# Copier en .env puis remplir. Ne jamais committer le .env.

# ── obligatoire ────────────────────────────────────────────────────────
# Token donné par @BotFather sur Telegram
TELEGRAM=
# Clé API sur console.groq.com (gratuite)
GROQ=
# Ton identifiant Telegram, donné par @userinfobot. Le bot ne répond
# qu'à cet identifiant : tout le reste est ignoré en silence.
MY_ID=

# ── optionnel ──────────────────────────────────────────────────────────
# Ville par défaut pour la météo et le brief (mid et high)
CITY=Paris
# Heure du brief du matin, HH:MM, ou off. Défaut : off en mid, 7:30 en high
BRIEF=7:30

# Fuseau et fichier de base
TZ_NAME=Europe/Paris
DB_PATH=joorvis.db

# Modèles Groq. À changer seulement si un modèle sort du catalogue.
CHAT_MODEL=openai/gpt-oss-120b
AUDIO_MODEL=whisper-large-v3-turbo
VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
